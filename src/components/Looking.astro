---
import { t, type Lang } from '../i18n/ui';
import { looking } from '../data/looking';
import Roll from './Roll.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section" id="looking">
  <div class="section-inner">
    <div class="section-head" data-reveal>
      <h2>{t(lang, 'lkTitle')}</h2>
      <p>{t(lang, 'lkCaption')}</p>
    </div>
    <ol class="list">
      {looking[lang].map((s, i) => (
        <li data-reveal style={`--d:${i * 0.1}s`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <a class="cta" href="#contact"><Roll text={t(lang, 'lkCta')} /> <span aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
  .list { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 44px); }
  li { border-top: 1px solid var(--line); padding-top: 20px; }
  .num { display: block; margin-bottom: 26px; color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; }
  h3 { margin: 0 0 10px; font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 600; letter-spacing: -.03em; }
  p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.6; max-width: 24em; }
  .cta { display: inline-flex; gap: 8px; align-items: center; margin-top: 40px; font-size: .9rem; font-weight: 600; text-decoration: none; }
  @media (max-width: 760px) { .list { grid-template-columns: 1fr; gap: 32px; } }
</style>
