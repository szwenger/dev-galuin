---
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'en' ? '/de/' : '/';
const items = [['skills', 'navSkills'], ['projects', 'navProjects'], ['experience', 'navExperience'], ['freelance', 'navFreelance'], ['contact', 'navContact']] as const;
---
<header class="nav">
  <a class="brand" href="#top">{profile[lang].name.split(' ')[0]}</a>
  <div class="tools">
    <a data-lang-toggle href={other} hreflang={lang === 'en' ? 'de' : 'en'} lang={lang === 'en' ? 'de' : 'en'} aria-label={t(lang, 'langName')}>{t(lang, 'langLabel')}</a>
    <button type="button" class="ic" data-theme-toggle aria-label={t(lang, 'themeToggle')}><span aria-hidden="true">◐</span></button>
    <button type="button" class="menu" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label={t(lang, 'menu')}><span aria-hidden="true">•••</span></button>
  </div>
  <nav id="menu" aria-label="Main">
    <ul data-menu>
      {items.map(([id, key]) => <li><a href={`#${id}`}>{t(lang, key)}</a></li>)}
    </ul>
  </nav>
</header>
<script>
  import { initNav } from '../scripts/theme';
  initNav();
</script>
<style>
  .nav { position: fixed; z-index: 10; top: 22px; left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - 24px);
    display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 6px 6px 6px 18px;
    border-radius: 10px; background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(14px); border: 1px solid var(--line); }
  .brand { font-weight: 700; text-decoration: none; font-size: .95rem; }
  .tools { display: flex; align-items: center; gap: 6px; font-size: .78rem; }
  .tools a { text-decoration: none; padding: 5px 9px; border-radius: 6px; color: var(--muted); }
  .tools a:hover { color: var(--fg); }
  button { cursor: pointer; font: inherit; border: 0; border-radius: 7px; height: 30px; min-width: 30px; }
  .ic { background: none; color: var(--fg); }
  .menu { background: var(--fg); color: var(--bg); padding: 0 12px; letter-spacing: .1em; font-size: .7rem; }
  ul { display: none; list-style: none; margin: 0; padding: 8px; position: absolute; top: calc(100% + 8px); right: 0; min-width: 200px;
    background: var(--bg); border: 1px solid var(--line); border-radius: 12px; }
  ul.open { display: block; }
  ul a { display: block; padding: 10px 14px; text-decoration: none; border-radius: 8px; }
  ul a:hover { background: var(--line); }
</style>
