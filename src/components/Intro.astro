---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = profile[lang];
const pitch = p.pitch.split('**');
---
<section class="intro" id="intro">
  <div class="grid">
    <div class="left" data-reveal>
      <h2>{t(lang, 'greeting')}</h2>
      <p class="role">{p.role}</p>
      <hr />
      <p class="small">{t(lang, 'currentlyAt')}</p>
      <p class="org"><strong>{p.currentOrg}</strong><br />{p.currentRole}</p>
    </div>
    <div class="slot" data-portrait-slot>
      <Image src={portrait} alt={t(lang, 'portraitAlt')} width={403} height={500} loading="eager" />
    </div>
    <div class="right" data-reveal>
      <p class="pitch">{pitch.map((s, i) => (i % 2 ? <strong>{s}</strong> : s))}</p>
      <a class="btn" href="#projects">{t(lang, 'explore')} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  .intro { position: relative; z-index: 1; padding: 10vh var(--gutter) 22vh; }
  .grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: clamp(20px, 3vw, 48px); align-items: center; max-width: 1000px; margin-inline: auto; }
  h2 { font-size: clamp(2.4rem, 4.6vw, 4.2rem); line-height: .98; letter-spacing: -.03em; margin: 0 0 .5em; font-weight: 700; }
  .role { font-size: clamp(1.1rem, 1.5vw, 1.35rem); font-weight: 600; line-height: 1.2; margin: 0; max-width: 11em; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 1.6em 0 1em; }
  .small { margin: 0 0 .4em; font-size: .78rem; color: var(--muted); }
  .org { margin: 0; font-size: .85rem; }
  .slot { width: clamp(180px, 15vw, 240px); aspect-ratio: 403 / 500; border-radius: 11px; overflow: hidden; }
  .slot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.journey-on) .slot :global(img) { visibility: hidden; }
  .pitch { font-size: clamp(1.1rem, 1.6vw, 1.5rem); line-height: 1.3; margin: 0 0 1.4em; font-weight: 500; }
  .pitch strong { font-weight: 700; }
  .btn { display: inline-flex; gap: 10px; align-items: center; padding: 11px 18px; border-radius: 6px; background: var(--fg); color: var(--bg); text-decoration: none; font-size: .8rem; font-weight: 600; transition: transform .3s var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; justify-items: start; gap: 28px; }
    .slot { width: min(62vw, 260px); }
  }
</style>
