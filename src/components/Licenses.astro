---
import LegalShell from './LegalShell.astro';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const libs: [string, string, string][] = [
  ['Space Grotesk (font)', 'OFL-1.1', 'https://github.com/floriankarsten/space-grotesk'],
  ['Astro (build tool)', 'MIT', 'https://github.com/withastro/astro'],
  ['Simple Icons (GitHub logo)', 'CC0-1.0', 'https://simpleicons.org'],
  ['Bootstrap Icons (LinkedIn logo)', 'MIT', 'https://github.com/twbs/icons'],
];
const copy = {
  en: { title: 'Open-source licences', intro: 'This site is built from open-source parts. The font Space Grotesk is served from this site under the SIL Open Font License 1.1; its copyright line and the full licence text are here: ', link: 'OFL-SpaceGrotesk.txt', lib: 'Component', licence: 'Licence', source: 'Source', foot: 'Portrait and project images are my own.' },
  de: { title: 'Open-Source-Lizenzen', intro: 'Diese Seite besteht aus Open-Source-Teilen. Die Schrift Space Grotesk wird von dieser Seite unter der SIL Open Font License 1.1 ausgeliefert; Copyright-Zeile und vollständiger Lizenztext stehen hier: ', link: 'OFL-SpaceGrotesk.txt', lib: 'Komponente', licence: 'Lizenz', source: 'Quelle', foot: 'Porträt und Projektbilder stammen von mir.' },
}[lang];
---
<LegalShell lang={lang} slug="licenses" title={copy.title}>
  <h1>{copy.title}</h1>
  <p>{copy.intro}<a href="/licenses/OFL-SpaceGrotesk.txt">{copy.link}</a></p>
  <table>
    <thead><tr><th>{copy.lib}</th><th>{copy.licence}</th><th>{copy.source}</th></tr></thead>
    <tbody>
      {libs.map(([name, lic, url]) => <tr><td>{name}</td><td>{lic}</td><td><a href={url} rel="noopener">{url.replace('https://', '')}</a></td></tr>)}
    </tbody>
  </table>
  <p class="meta">{copy.foot}</p>
</LegalShell>
