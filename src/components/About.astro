---
import Hero from './Hero.astro';
import Intro from './Intro.astro';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="about" id="about">
  <canvas aria-hidden="true" data-code-canvas></canvas>
  <Hero lang={lang} />
  <Intro lang={lang} />
</div>
<script>
  import { initCodeCanvas } from '../scripts/codecanvas';
  const c = document.querySelector<HTMLCanvasElement>('[data-code-canvas]');
  if (c) initCodeCanvas(c);
</script>
<style>
  .about { position: relative; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
</style>
