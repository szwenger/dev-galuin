---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';
import { links } from '../data/profile';
import Roll from './Roll.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fileIcon = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>';
---
<section class="section" id="projects" data-projects>
  <div class="section-inner">
    <div class="section-head" data-reveal>
      <h2>{t(lang, 'projTitle')}</h2>
      <a class="gh" href={links.github} rel="me noopener" target="_blank"><Roll text="GitHub" /> <span aria-hidden="true">↗</span></a>
    </div>
    <p class="hint" data-reveal>{t(lang, 'projCaption')}</p>

    <ul class="grid">
      {projects.map((p, i) => (
        <li data-reveal style={`--d:${i * 0.08}s`}>
          <button type="button" class="folder" data-folder={p.id} aria-expanded="false" aria-controls={`study-${p.id}`}>
            <span class="sr-only">{t(lang, 'projView')}: {p.title}, </span>
            <span class="scene" aria-hidden="true">
              <span class="back"></span>
              <span class="paper p-back"><Fragment set:html={fileIcon} /><span class="label">{p.stack.slice(0, 2).join(' · ')}</span><span class="lines"></span></span>
              <span class="paper p-preview">
                {p.image
                  ? <Image src={p.image} alt="" width={400} loading="lazy" />
                  : <span class="sheet"><span>{p.kind[lang]}</span><strong>{p.title}</strong><span>{p.stack[0]}</span></span>}
              </span>
              <span class="paper p-front"><Fragment set:html={fileIcon} /><span class="label">{t(lang, 'projNotes')}</span><span class="lines"></span></span>
              <span class="front">
                <span class="title">{p.title}</span>
                <span class="open">↗</span>
              </span>
            </span>
            <span class="caption"><span>{p.kind[lang]}</span><span class="act" aria-hidden="true"><Roll text={t(lang, 'projView')} /> <span aria-hidden="true">↗</span></span></span>
          </button>
        </li>
      ))}
    </ul>

    <div class="panel" id="project-panel" role="region" aria-label={t(lang, 'projDetails')} tabindex="-1" data-panel>
      <div class="toolbar">
        <span>{t(lang, 'projDetails')}</span>
        <button type="button" class="close" data-close aria-label={t(lang, 'projClose')}>✕</button>
      </div>
      {projects.map((p) => (
        <article class="study" id={`study-${p.id}`} data-study={p.id} aria-labelledby={`title-${p.id}`}>
          <div class:list={['shots', p.inset && `has-${p.inset.kind}`]}>
            <div class="shot">
              {p.image
                ? <Image src={p.image} alt="" width={720} loading="lazy" />
                : <span class="sheet big"><span>{p.kind[lang]}</span><strong>{p.title}</strong><span>{p.stack.join(' · ')}</span></span>}
            </div>
            {p.inset?.kind === 'phone' && <Image class="inset phone" src={p.inset.src} alt="" width={200} loading="lazy" />}
            {p.inset?.kind === 'figure' && <a href={p.inset.src.src} target="_blank" rel="noopener" aria-label={`${p.title}: ${t(lang, 'projFigure')}`}><Image class="inset figure" src={p.inset.src} alt="" width={480} loading="lazy" /></a>}
          </div>
          <div class="info">
            <h3 id={`title-${p.id}`}>{p.title}</h3>
            <p class="kind">{p.kind[lang]}</p>
            <p class="summary">{p.summary[lang]}</p>
            <h4>{t(lang, 'projInside')}</h4>
            <ul class="details">{p.details[lang].map((d) => <li>{d}</li>)}</ul>
            <ul class="stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
            <p class="links">
              {p.repo && <a href={p.repo} rel="noopener" target="_blank"><Roll text={t(lang, 'projSource')} /> <span aria-hidden="true">↗</span></a>}
              {p.live && <a href={p.live} rel="noopener" target="_blank"><Roll text={t(lang, 'projLive')} /> <span aria-hidden="true">↗</span></a>}
              {!p.repo && <span class="private">{t(lang, 'projPrivate')}</span>}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  import { initProjects } from '../scripts/projects';
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach(initProjects);
</script>
<style>
  .gh { display: inline-flex; gap: 6px; font-size: .9rem; font-weight: 600; text-decoration: none; }
  .hint { margin: 18px 0 0; color: var(--muted); font-size: .9rem; }
  .grid { list-style: none; margin: 0; padding: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; }

  /* Folder: back panel, three papers, glass front. Values measured from the reference, own markup. */
  .folder { display: block; width: 100%; padding: 0; border: 0; border-radius: 16px; background: none; color: var(--fg); font: inherit; text-align: left; cursor: pointer; }
  .folder:focus-visible { outline: 2px solid var(--fg); outline-offset: 8px; }
  .scene { position: relative; display: block; height: 250px; perspective: 900px; transform: rotateY(var(--lean, 0deg)); transition: transform .25s var(--ease); }
  .back { position: absolute; inset: 62px 8px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-strong); }
  .back::before { content: ''; position: absolute; top: -23px; left: -1px; width: 44%; height: 30px; border: 1px solid var(--line); border-bottom: 0; border-radius: 12px 16px 0 0; background: var(--surface-strong); }
  .paper { position: absolute; top: 55px; left: 12%; right: 12%; height: 160px; display: flex; flex-direction: column; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 9px; background: var(--bg); color: var(--fg); font-size: 11px; font-weight: 600; box-shadow: 0 10px 20px -14px rgba(0, 0, 0, .4); transform-origin: 50% 100%; transition: transform .45s var(--ease); }
  .label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lines { position: relative; height: 34px; border-block: 1px solid var(--line); }
  .lines::after { content: ''; position: absolute; top: 50%; left: 0; right: 28%; height: 1px; background: var(--line); }
  .p-back { transform: translate(-12px, -5px) rotate(-9deg); }
  .p-preview { padding: 6px; overflow: hidden; transform: translate(10px, -1px) rotate(6deg); }
  .p-preview :global(img) { width: 100%; height: 112px; object-fit: cover; object-position: left top; border-radius: 5px; filter: grayscale(1); }
  .p-front { transform: translateY(18px) rotate(-2deg); }
  .sheet { display: flex; flex-direction: column; justify-content: space-between; gap: 8px; min-height: 112px; padding: 10px; border-radius: 5px; background: var(--surface); }
  .sheet span { font-size: 9px; font-weight: 400; color: var(--muted); }
  .sheet strong { font-size: 16px; font-weight: 600; line-height: 1.1; letter-spacing: -.02em; }
  .front { position: absolute; inset: 104px 0 8px; display: flex; justify-content: space-between; align-items: end; gap: 10px; padding: 20px; border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); border-radius: 14px; background: color-mix(in srgb, var(--surface) 62%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 18px 25px -20px rgba(0, 0, 0, .53); transform-origin: 50% 100%; transition: transform .45s var(--ease); }
  .front::before { content: ''; position: absolute; top: -17px; left: -1px; width: 46%; height: 22px; border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); border-bottom: 0; border-radius: 12px 16px 0 0; background: color-mix(in srgb, var(--surface) 85%, transparent); }
  .title { font-size: 1.35rem; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; }
  .open { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--fg); color: var(--bg); font-size: 15px; }
  .caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; padding: 14px 4px; color: var(--muted); font-size: .8rem; }
  .act { display: inline-flex; gap: 5px; color: var(--fg); font-weight: 600; transition: transform .25s var(--ease); }
  @media (hover: hover) { .folder:hover .act { transform: scale(1.06); } }

  /* Open state: papers fan up, the front tips back. */
  .folder:is(:focus-visible, [aria-expanded='true']) .p-back { transform: translate(-22px, -34px) rotate(-14deg); }
  .folder:is(:focus-visible, [aria-expanded='true']) .p-preview { transform: translate(20px, -44px) rotate(10deg); }
  .folder:is(:focus-visible, [aria-expanded='true']) .p-front { transform: translateY(-10px) rotate(-3deg); }
  .folder:is(:focus-visible, [aria-expanded='true']) .front { transform: rotateX(-25deg); }
  @media (hover: hover) {
    .folder:hover .p-back { transform: translate(-22px, -34px) rotate(-14deg); }
    .folder:hover .p-preview { transform: translate(20px, -44px) rotate(10deg); }
    .folder:hover .p-front { transform: translateY(-10px) rotate(-3deg); }
    .folder:hover .front { transform: rotateX(-25deg); }
  }

  /* Details panel. Without JS every study stays visible as a plain list. */
  .panel { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); scroll-margin-top: 110px; }
  .panel:focus { outline: none; }
  :global(.js-projects) .panel[hidden], .study[hidden] { display: none; }
  .toolbar { display: none; justify-content: space-between; align-items: center; margin-bottom: 24px; color: var(--muted); font-size: .85rem; }
  :global(.js-projects) .toolbar { display: flex; }
  .close { width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--fg); cursor: pointer; transition: transform .3s var(--ease); }
  .close:hover { transform: rotate(90deg); }
  .study { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; align-items: start; padding-bottom: 40px; }
  :global(.js-projects) .study { animation: study-in .6s var(--ease); }
  @keyframes study-in { from { opacity: 0; transform: translateY(16px); } }
  .shots { position: sticky; top: 110px; }
  .shot { overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .shot :global(img) { width: 100%; height: auto; }
  /* Second shot overlaps the main one, shifted past its bottom-right corner. */
  .has-phone { padding: 0 9% 16% 0; }
  .has-figure { padding: 0 10% 22% 0; }
  .shots :global(.inset) { position: absolute; right: 0; bottom: 0; height: auto; box-shadow: 0 24px 40px -18px rgba(0, 0, 0, .6); }
  .shots :global(.inset.phone) { width: 25%; border: 5px solid #0d0d0c; border-radius: 22px; outline: 1px solid var(--line); }
  .shots :global(.inset.figure) { width: 58%; border: 1px solid var(--line); border-radius: 10px; }
  .sheet.big { min-height: 280px; padding: 28px; border-radius: 0; }
  .sheet.big span { font-size: .8rem; }
  .sheet.big strong { font-size: clamp(2rem, 4vw, 3.2rem); }
  h3 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 600; letter-spacing: -.03em; }
  .kind { margin: 4px 0 18px; color: var(--muted); font-size: .9rem; }
  .summary { margin: 0 0 26px; font-size: 1.05rem; line-height: 1.55; }
  h4 { margin: 0 0 10px; padding-top: 14px; border-top: 1px solid var(--line); font-size: .8rem; font-weight: 600; }
  .details { margin: 0 0 22px; padding-left: 1.1em; color: var(--muted); font-size: .92rem; line-height: 1.6; }
  .stack { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li { padding: 5px 10px; border: 1px solid var(--line); border-radius: 6px; font-size: .75rem; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; margin: 0; font-size: .9rem; font-weight: 600; }
  .links a { display: inline-flex; gap: 6px; text-decoration: none; }
  .private { color: var(--muted); font-weight: 400; font-size: .85rem; }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; max-width: 380px; margin-inline: auto; }
    .study { grid-template-columns: 1fr; gap: 24px; }
    .shots { position: relative; top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene, .paper, .front, .act { transition: none !important; transform: none !important; }
    :global(.js-projects) .study { animation: none; }
  }
</style>
