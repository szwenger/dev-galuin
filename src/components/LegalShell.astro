---
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; slug: string; title: string; noindex?: boolean }
const { lang, slug, title, noindex = false } = Astro.props;
const home = lang === 'en' ? '/' : '/de/';
const other = lang === 'en' ? `/de/${slug}/` : `/${slug}/`;
---
<Base lang={lang} title={`${title} · Simon Zwenger`} description={title} noindex={noindex}>
  <header class="bar">
    <a href={home}>← {t(lang, 'backHome')}</a>
    <a href={other} hreflang={lang === 'en' ? 'de' : 'en'} lang={lang === 'en' ? 'de' : 'en'} aria-label={t(lang, 'langName')}>{t(lang, 'langLabel')}</a>
  </header>
  <main class="doc">
    <slot />
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .bar { display: flex; justify-content: space-between; gap: 16px; padding: 22px var(--gutter) 0; font-size: .9rem; }
  .bar a { text-decoration: none; padding-block: 8px; margin-block: -8px; }
  .bar a:hover { text-decoration: underline; }
  .doc { padding: clamp(32px, 6vw, 64px) var(--gutter) 0; max-width: calc(46rem + 2 * var(--gutter)); margin-inline: auto; }
  .doc :global(h1) { margin: 0 0 16px; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600; letter-spacing: -.035em; line-height: 1; }
  .doc :global(h2) { margin: 28px 0 8px; font-size: 1.05rem; }
  .doc :global(p) { margin: 0 0 10px; line-height: 1.65; }
  .doc :global(.meta) { color: var(--muted); font-size: .85rem; }
  .doc :global(code) { font-size: .9em; }
  .doc :global(table) { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .doc :global(th), .doc :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  .doc :global(th) { color: var(--muted); font-weight: 500; }
</style>
